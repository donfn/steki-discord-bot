# Each service reads only its own variables. On Railway the web service holds the
# originals (the existing "stekibot" service, renamed web) and the others reference
# them, for example DISCORD_TOKEN=${{web.DISCORD_TOKEN}}.

# ── Every service ───────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Signs requests between the services and the email and captcha links. At least 32
# characters: openssl rand -hex 32
INTERNAL_SECRET=
# The bucket holds the databases too. Locally, a MinIO with BUCKET_PATH_STYLE=1.
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# BUCKET_PATH_STYLE=1
# Start with empty databases if the bucket has none. Local development only: in
# production a missing database must stop the service, since an empty one would let
# members reuse addresses that are taken.
# DB_CREATE_EMPTY=1
# debug | info | warn | error  (default: info)
LOG_LEVEL=info
# Optional. Reports events to PostHog; nothing is loaded in visitors' browsers, and
# no message text or email address is sent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── registration ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Its domain must be verified in Resend.
EMAIL_FROM=Steki <steki@poiw.org>
# PUBLIC_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_URL=
# MODERATION_URL=http://${{moderation.RAILWAY_PRIVATE_DOMAIN}}:8081
MODERATION_URL=
# WEB_URL=http://${{web.RAILWAY_PRIVATE_DOMAIN}}:8081
WEB_URL=

# ── moderation ──────────────────────────────────────────────────────────────
# PUBLIC_URL, WEB_URL as above, and:
# REGISTRATION_URL=http://${{registration.RAILWAY_PRIVATE_DOMAIN}}:8081
REGISTRATION_URL=
# Comma-separated substrings; a link containing any of them is removed and the
# sender is timed out.
URL_BLACKLIST=

# ── web ─────────────────────────────────────────────────────────────────────
# REGISTRATION_URL and MODERATION_URL as above, and:
# Signs material links, sessions and MCP tokens. No other service has it.
JWT_SECRET=
# Optional on Railway: defaults to the service's public domain.
# PUBLIC_URL=
# The MCP server's Discord login. Off unless both are set. In the developer portal
# add the redirect <PUBLIC_URL>/oauth/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google AI Studio key for the image check. Without it, images only get a format check.
GOOGLE_AI_TOKEN=
GOOGLE_AI_MODEL=
# The isolated image and compression service.
# On Railway: http://${{blastdoor.RAILWAY_PRIVATE_DOMAIN}}:${{blastdoor.PORT}}
BLASTDOOR_URL=
# Railway project token: IP blocks at the edge and Under Attack Mode.
RAILWAY_TOKEN=
