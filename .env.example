# ── Required ────────────────────────────────────────────────────────────────
# Discord bot token.
DISCORD_TOKEN=

# Resend API key, for sending verification codes.
RESEND_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# SQLite database file. Default: steki.db here, or steki.db inside the Railway
# volume (RAILWAY_VOLUME_MOUNT_PATH). On Railway the bot refuses to start
# without a volume attached.
DATABASE_PATH=

# Only while moving off Postgres: the old database, copied into the SQLite
# file once on first boot. Remove it (and the Postgres service) afterwards.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Verified sender. Its domain must be verified in Resend.
EMAIL_FROM=Steki <steki@poiw.org>

# Comma-separated substrings; a link containing any of them is removed and the
# sender is timed out. Leave empty to disable link filtering.
URL_BLACKLIST=

# debug | info | warn | error  (default: info)
LOG_LEVEL=info

# Port for /healthz and the media guard's verification page (Railway sets
# this automatically).
PORT=8080

# Required. Signs the registration email links and the media guard's captcha
# links. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Public base URL of the link and verification pages. Required, but on Railway
# it defaults to the service's public domain (RAILWAY_PUBLIC_DOMAIN), so it can
# stay empty there.
PUBLIC_URL=

# S3-compatible bucket the PDFs posted in the server are backed up to. The
# backup, the "Προβολή υλικού" sticky messages and the material page are off
# unless all of these are set. On Railway, reference the bucket's variables:
#   BUCKET_NAME=${{steki-backups.BUCKET}}  BUCKET_ENDPOINT=${{steki-backups.ENDPOINT}}
#   BUCKET_REGION=${{steki-backups.REGION}}
#   BUCKET_ACCESS_KEY_ID=${{steki-backups.ACCESS_KEY_ID}}
#   BUCKET_SECRET_ACCESS_KEY=${{steki-backups.SECRET_ACCESS_KEY}}
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=

# ── Migration tool only (cmd/migrate) ───────────────────────────────────────
# The old MongoDB URL, read only by the one-shot migration tool to import the
# historical usedEmails hash set. Not needed by the bot itself.
MONGO_URL=
