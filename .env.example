# ── Required ────────────────────────────────────────────────────────────────
# Discord bot token.
DISCORD_TOKEN=

# PostgreSQL connection string. On Railway, set this to a reference:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Resend API key, for sending verification codes.
RESEND_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Verified sender. Its domain must be verified in Resend.
EMAIL_FROM=Steki <steki@poiw.org>

# Comma-separated substrings; a link containing any of them is removed and the
# sender is timed out. Leave empty to disable link filtering.
URL_BLACKLIST=

# debug | info | warn | error  (default: info)
LOG_LEVEL=info

# Port for /healthz and the media guard's verification page (Railway sets
# this automatically).
PORT=8080

# Media guard: a member who posts an attachment or a link twice within an hour
# is timed out for a day and DMed a captcha link that lifts it. Off unless
# JWT_SECRET is set. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Public base URL of the verification page. On Railway this defaults to the
# service's public domain (RAILWAY_PUBLIC_DOMAIN), so it can stay empty there.
PUBLIC_URL=

# ── Migration tool only (cmd/migrate) ───────────────────────────────────────
# The old MongoDB URL, read only by the one-shot migration tool to import the
# historical usedEmails hash set. Not needed by the bot itself.
MONGO_URL=
